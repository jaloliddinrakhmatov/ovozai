{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "OvozAI NestJS",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "exclude": ["node_modules", "dist"]
}
