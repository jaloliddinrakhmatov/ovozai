# ============================================================
# OvozAI — Environment variables (EXAMPLE)
# Copy to `.env` (`cp .env.example .env`) and adjust as needed.
# NEVER commit a real `.env`. NEVER hardcode secrets in code.
# Only the variables marked [PHASE 1] are required for the Phase 1 foundation.
# ============================================================

# --- Runtime ---------------------------------------------------- [PHASE 1]
NODE_ENV=development

# --- PostgreSQL (docker-compose) -------------------------------- [PHASE 1]
POSTGRES_USER=ovozai
POSTGRES_PASSWORD=ovozai
POSTGRES_DB=ovozai
POSTGRES_PORT=5432
# Prisma connection string (used by apps/api and packages/database)
DATABASE_URL=postgresql://ovozai:ovozai@localhost:5432/ovozai?schema=public

# --- Redis (docker-compose) ------------------------------------- [PHASE 1]
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API (NestJS) ----------------------------------------------- [PHASE 1]
API_PORT=3001
API_HOST=0.0.0.0
# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Public base URL of the web app (used to build invitation accept links)
APP_WEB_URL=http://localhost:3000

# --- Auth / tokens (NestJS) ------------------------------------- [PHASE 2]
# HMAC secret for signing access JWTs. REQUIRED (>=32 chars) in production;
# a dev fallback is used if unset in development. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-insecure-access-secret-change-me-0123456789
# Access-token lifetime (seconds); refresh-token/session + invitation lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
INVITATION_TTL_SECONDS=604800
# Brute-force protection on auth endpoints (Redis-backed, best-effort)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Embeddings / knowledge base -------------------------------- [PHASE 3]
# Provider for knowledge-base embeddings. "local" is a deterministic, no-API-key
# lexical embedder (dev/test default). "openai" uses an OpenAI-compatible HTTP API.
# The API and the jobs-worker MUST share these values so query and chunk vectors
# are comparable.
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=256
# For EMBEDDING_PROVIDER=openai:
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# --- Web (Next.js) ---------------------------------------------- [PHASE 1]
# Public base URL of the API (exposed to the browser — must be NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Jobs worker (BullMQ) --------------------------------------- [PHASE 1]
JOBS_WORKER_CONCURRENCY=5

# --- Internal voice-worker <-> API channel ---------------------- [PHASE 4]
# Shared service token + HMAC secret. MUST match between apps/api and the
# voice-worker. Generate strong values in production: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=dev-insecure-service-token-change-me
INTERNAL_HMAC_SECRET=dev-insecure-hmac-secret-change-me-0123456789

# --- Voice providers (STT/LLM/TTS) ------------------------------ [PHASE 4]
# "local" = deterministic, no-API-key providers (dev/test default; what the
# simulated call uses). "openai" = real OpenAI-compatible HTTP adapters.
VOICE_PROVIDER=local
# For VOICE_PROVIDER=openai:
# VOICE_PROVIDER_API_KEY=
# VOICE_PROVIDER_BASE_URL=https://api.openai.com/v1
# Base URL of the API the voice-worker reports to (internal channel):
VOICE_API_URL=http://localhost:3001
# Run one simulated call on worker start (dev/demo); set to an agent id:
# VOICE_DEV_CALL_AGENT_ID=

# ============================================================
# LATER PHASES — listed for reference, NOT required yet.
# ============================================================

# --- LiveKit (live media plane; needs a server + @livekit/rtc-node) ---
# Set these to wire the real LiveKit transport (see apps/voice-worker/
# src/livekit-transport.ts). Not required for the simulated call path.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- Object storage / S3-compatible (recordings — Phase 5+) ---
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=ovozai-recordings
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
