# ============================================================
# OvozAI — Environment variables (EXAMPLE)
# Copy to `.env` (`cp .env.example .env`) and adjust as needed.
# NEVER commit a real `.env`. NEVER hardcode secrets in code.
# Only the variables marked [PHASE 1] are required for the Phase 1 foundation.
# ============================================================

# --- Runtime ---------------------------------------------------- [PHASE 1]
NODE_ENV=development

# --- PostgreSQL (docker-compose) -------------------------------- [PHASE 1]
POSTGRES_USER=ovozai
POSTGRES_PASSWORD=ovozai
POSTGRES_DB=ovozai
POSTGRES_PORT=5432
# Prisma connection string (used by apps/api and packages/database)
DATABASE_URL=postgresql://ovozai:ovozai@localhost:5432/ovozai?schema=public

# --- Redis (docker-compose) ------------------------------------- [PHASE 1]
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API (NestJS) ----------------------------------------------- [PHASE 1]
API_PORT=3001
API_HOST=0.0.0.0
# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Public base URL of the web app (used to build invitation accept links)
APP_WEB_URL=http://localhost:3000

# --- Auth / tokens (NestJS) ------------------------------------- [PHASE 2]
# HMAC secret for signing access JWTs. REQUIRED (>=32 chars) in production;
# a dev fallback is used if unset in development. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-insecure-access-secret-change-me-0123456789
# Access-token lifetime (seconds); refresh-token/session + invitation lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
INVITATION_TTL_SECONDS=604800
# Brute-force protection on auth endpoints (Redis-backed, best-effort)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Embeddings / knowledge base -------------------------------- [PHASE 3]
# Provider for knowledge-base embeddings. "local" is a deterministic, no-API-key
# lexical embedder (dev/test default). "openai" uses an OpenAI-compatible HTTP API.
# The API and the jobs-worker MUST share these values so query and chunk vectors
# are comparable.
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=256
# For EMBEDDING_PROVIDER=openai:
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# --- Web (Next.js) ---------------------------------------------- [PHASE 1]
# Public base URL of the API (exposed to the browser — must be NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Jobs worker (BullMQ) --------------------------------------- [PHASE 1]
JOBS_WORKER_CONCURRENCY=5

# --- Internal voice-worker <-> API channel ---------------------- [PHASE 4]
# Shared service token + HMAC secret. MUST match between apps/api and the
# voice-worker. Generate strong values in production: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=dev-insecure-service-token-change-me
INTERNAL_HMAC_SECRET=dev-insecure-hmac-secret-change-me-0123456789

# --- Voice providers (STT/LLM/TTS) ------------------------------ [PHASE 4]
# "local" = deterministic dev-bridge (no key; NOT real speech). "openai" = real
# OpenAI-compatible HTTP adapters (OpenAI, or any OpenAI-compatible endpoint via
# VOICE_PROVIDER_BASE_URL — Groq, Gemini, …). Each modality can be set separately.
VOICE_PROVIDER=local
# Per-modality overrides (default to VOICE_PROVIDER). For the browser Test Agent,
# the browser does STT+TTS (free Web Speech API), so only the LLM needs a provider.
# VOICE_STT_PROVIDER=local
# VOICE_LLM_PROVIDER=local
# VOICE_TTS_PROVIDER=local
# Credentials: a shared key/URL, OR per-modality keys so different modalities use
# different providers (each falls back to the shared VOICE_PROVIDER_* if unset):
# VOICE_PROVIDER_API_KEY= / VOICE_PROVIDER_BASE_URL=https://api.openai.com/v1
# VOICE_LLM_API_KEY= / VOICE_LLM_BASE_URL=
# VOICE_STT_API_KEY= / VOICE_STT_BASE_URL=
# VOICE_TTS_API_KEY= / VOICE_TTS_BASE_URL=
# VOICE_STT_MODEL= / VOICE_LLM_MODEL= / VOICE_TTS_MODEL=
#
# FREE real LLM via Groq (no credit card — console.groq.com/keys):
#   VOICE_LLM_PROVIDER=openai
#   VOICE_LLM_BASE_URL=https://api.groq.com/openai/v1
#   VOICE_LLM_API_KEY=gsk_...
#   VOICE_LLM_MODEL=qwen/qwen3.8-27b
#
# Uzbek TTS via NeuronAI (paid credits; my.neuronai.uz -> API keys; key nai_...).
# NOTE: requires confirming NeuronAI's TTS endpoint is OpenAI-compatible + browser
# audio playback (not yet wired). Variable for the NeuronAI key: VOICE_TTS_API_KEY.
#   VOICE_TTS_PROVIDER=openai
#   VOICE_TTS_BASE_URL=https://my.neuronai.uz/api/v1
#   VOICE_TTS_API_KEY=nai_...
#   VOICE_TTS_MODEL=<voice>
#
# Base URL of the API the voice-worker reports to (internal channel):
VOICE_API_URL=http://localhost:3001
# Browser "Test Agent" WebSocket gateway port (voice-worker):
# VOICE_WS_PORT=8787
# Run one simulated call on worker start (dev/demo); set to an agent id:
# VOICE_DEV_CALL_AGENT_ID=
# VOICE_DEV_CALL_MODE=qa   # qa | transfer

# --- Browser Test-Agent gateway (API side) ---------------------- [real-voice]
# WebSocket URL of the voice-worker gateway, handed to the browser in the ticket.
# VOICE_WS_PUBLIC_URL=ws://localhost:8787
# Test-session ticket lifetime (seconds) before the browser must connect.
# VOICE_TEST_SESSION_TTL_SECONDS=120

# --- Call recording storage ------------------------------------- [PHASE 5]
# "local" writes recordings to the filesystem (shared temp dir by default) — the
# API and voice-worker MUST share this config so recordings resolve. "s3" uses an
# S3-compatible store (deployment dependency; see docs/VOICE_PIPELINE.md §8).
STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=/tmp/ovozai-storage
# STORAGE_S3_BUCKET=ovozai-recordings
# STORAGE_S3_REGION=
# STORAGE_S3_ENDPOINT=

# --- Billing & integrations providers --------------------------- [PHASE 6]
# "mock" providers are deterministic, no-key defaults (dev/test). Real providers
# (Stripe / Google Calendar / SMTP+SMS) are documented boundaries — set these to
# wire them in deployment.
PAYMENT_PROVIDER=mock
# PAYMENT_API_KEY=
CALENDAR_PROVIDER=mock
NOTIFICATION_PROVIDER=mock

# --- Hardening & compliance ------------------------------------- [PHASE 7]
# RLS-enforced DB connection: a non-superuser role (`ovozai_app`) for which
# PostgreSQL Row-Level Security applies (defense-in-depth behind the app-layer
# tenant guard). Create the role with infrastructure/rls/create-app-role.sql, then
# set this. UNSET (dev default) → the app uses the owner connection (RLS is a no-op
# for the owner) and the app-layer guard remains primary. See docs/COMPLIANCE.md §1.
# DATABASE_APP_URL=postgresql://ovozai_app:CHANGE_ME@localhost:5432/ovozai?schema=public
# Log output: "json" = structured, PII-redacted lines for aggregation (default in
# production); "pretty" = human-readable Nest logger (default otherwise).
# LOG_FORMAT=json
# Expose GET /api/v1/metrics (Prometheus exposition).
METRICS_ENABLED=true
# Declared data-residency region of PII stores (Law No. ZRU-547); surfaced on
# /metrics for auditability. "uz" = in-country.
DATA_REGION=uz

# ============================================================
# LATER PHASES — listed for reference, NOT required yet.
# ============================================================

# --- LiveKit (live media plane; needs a server + @livekit/rtc-node) ---
# Set these to wire the real LiveKit transport (see apps/voice-worker/
# src/livekit-transport.ts). Not required for the simulated call path.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- Object storage / S3-compatible (recordings — Phase 5+) ---
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=ovozai-recordings
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
