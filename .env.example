# ============================================================
# OvozAI — Environment variables (EXAMPLE)
# Copy to `.env` (`cp .env.example .env`) and adjust as needed.
# NEVER commit a real `.env`. NEVER hardcode secrets in code.
# Only the variables marked [PHASE 1] are required for the Phase 1 foundation.
# ============================================================

# --- Runtime ---------------------------------------------------- [PHASE 1]
NODE_ENV=development

# --- PostgreSQL (docker-compose) -------------------------------- [PHASE 1]
POSTGRES_USER=ovozai
POSTGRES_PASSWORD=ovozai
POSTGRES_DB=ovozai
POSTGRES_PORT=5432
# Prisma connection string (used by apps/api and packages/database)
DATABASE_URL=postgresql://ovozai:ovozai@localhost:5432/ovozai?schema=public

# --- Redis (docker-compose) ------------------------------------- [PHASE 1]
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API (NestJS) ----------------------------------------------- [PHASE 1]
API_PORT=3001
API_HOST=0.0.0.0
# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# --- Web (Next.js) ---------------------------------------------- [PHASE 1]
# Public base URL of the API (exposed to the browser — must be NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Jobs worker (BullMQ) --------------------------------------- [PHASE 1]
JOBS_WORKER_CONCURRENCY=5

# ============================================================
# LATER PHASES — listed for reference, NOT required for Phase 1.
# ============================================================

# --- Auth (Phase 2) ---
# JWT_ACCESS_SECRET=change-me
# JWT_ACCESS_TTL=900
# JWT_REFRESH_SECRET=change-me
# JWT_REFRESH_TTL=2592000

# --- Object storage / S3-compatible (Phase 4+) ---
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=ovozai-recordings
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- LiveKit (Phase 4+) ---
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- AI providers (Phase 4+) — provider-agnostic; keys live only in env ---
# STT_PROVIDER=
# LLM_PROVIDER=
# TTS_PROVIDER=

# --- Internal service auth: voice-worker <-> api (Phase 4+) ---
# INTERNAL_SERVICE_TOKEN=
