# pnpm configuration for the OvozAI monorepo
auto-install-peers=true
strict-peer-dependencies=false
# Keep the store/link behaviour deterministic across machines
link-workspace-packages=true
prefer-workspace-packages=true
# NestJS + Prisma play nicer with these commonly-needed packages hoisted
public-hoist-pattern[]=*reflect-metadata*
public-hoist-pattern[]=*@prisma/client*
public-hoist-pattern[]=*prisma*
