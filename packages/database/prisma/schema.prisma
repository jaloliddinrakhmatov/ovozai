// OvozAI — Prisma schema
//
// Prisma 7 notes:
//   - The datasource block no longer carries a `url`. Connection config for the
//     CLI (migrate/studio) lives in ../prisma.config.ts; the PrismaClient is
//     constructed at runtime with a driver adapter (@prisma/adapter-pg) — see
//     apps/api PrismaService.
//   - The generated client is emitted to ./src/generated/client (gitignored).
//
// Scope:
//   - Phase 1 implemented the tenancy/identity core (Organization, User,
//     Membership).
//   - Phase 2 (auth + multi-tenant core) adds Session (refresh-token rotation),
//     Invitation (invite-by-email), ApiKey, and AuditLog.
//   The full target data model is documented in ../../../docs/DATABASE.md and the
//   remaining entities (Agent, Call, Transcript, billing, …) land in later phases.
//
// ADR — primary keys: this project standardizes on Prisma-generated UUIDs
//   (`@default(uuid())`, stored as `text`), the fallback DATABASE.md §5.1 permits
//   when a `uuid_generate_v7()` generator is not provisioned. Phase 1 committed
//   this choice; Phase 2 keeps it uniform rather than churn existing columns or
//   add a DB extension. Revisit alongside the Phase 7 RLS/`@db.Uuid` hardening.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Lifecycle state of a tenant organization.
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

/// Role of a user within an organization (RBAC). AGENT_OPERATOR is reserved for
/// a later phase (human live-assist) and intentionally not yet implemented.
enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Lifecycle state of a user account.
enum UserStatus {
  ACTIVE
  DISABLED
}

/// Lifecycle state of an authentication session (refresh-token chain).
enum SessionStatus {
  ACTIVE
  REVOKED
}

/// Lifecycle state of an organization-scoped API key.
enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

/// Lifecycle state of a membership invitation.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// The kind of principal that performed an audited action.
enum AuditActorType {
  USER
  API_KEY
  SYSTEM
}

/// Lifecycle state of a configured AI agent.
enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/// Languages the platform supports for agents, calls, and content.
enum Language {
  UZ
  RU
  EN
}

/// Lifecycle state of a knowledge base.
enum KnowledgeBaseStatus {
  ACTIVE
  DISABLED
}

/// Ingestion state of a knowledge document.
enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Origin of a knowledge document. Phase 3 ingests TEXT/FAQ inline content;
/// UPLOAD/URL arrive with object storage + SSRF handling in a later phase.
enum KnowledgeSourceType {
  UPLOAD
  URL
  TEXT
  FAQ
}

/// Lifecycle state of an appointment.
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SHOW
}

/// Direction of a call.
enum CallDirection {
  INBOUND
  OUTBOUND
}

/// Lifecycle/outcome state of a call.
enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
  CANCELED
  TRANSFERRED
}

/// Speaker role for a transcript turn.
enum TranscriptRole {
  CALLER
  AGENT
  SYSTEM
  TOOL
}

/// Metered usage dimension.
enum UsageMetric {
  CALL_MINUTES
  STT_SECONDS
  TTS_CHARS
  LLM_TOKENS
}

/// Lifecycle state of a provisioned phone number.
enum PhoneNumberStatus {
  ACTIVE
  INACTIVE
  PORTING
  RELEASED
}

/// Lifecycle state of a tenant webhook endpoint.
enum WebhookStatus {
  ACTIVE
  DISABLED
}

/// Delivery state of a single webhook attempt record.
enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// Lifecycle state of an organization's subscription.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

/// Category of a business-facing integration.
enum IntegrationType {
  CALENDAR
  CRM
  PAYMENTS
  TELEPHONY
}

/// Connection state of an integration.
enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

/// Delivery channel for a notification.
enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

/// Delivery state of a notification.
enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Identity & tenancy core (Phase 1)
// ---------------------------------------------------------------------------

/// A tenant. Every tenant-scoped table in later phases carries `organizationId`.
model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  /// Default BCP-47 locale for the org (e.g. "uz", "ru", "en").
  locale    String             @default("uz")
  /// Data-retention policy (Phase 7). Max age in days before call recordings /
  /// transcript content are purged by the retention sweep; null = retain forever.
  recordingRetentionDays  Int?     @map("recording_retention_days")
  transcriptRetentionDays Int?     @map("transcript_retention_days")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  deletedAt DateTime?          @map("deleted_at")

  memberships        Membership[]
  sessions           Session[]
  invitations        Invitation[]
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]
  agents             Agent[]
  agentVersions      AgentVersion[]
  knowledgeBases     KnowledgeBase[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
  customers          Customer[]
  appointments       Appointment[]
  calls              Call[]
  callEvents         CallEvent[]
  transcripts        Transcript[]
  transcriptTurns    TranscriptTurn[]
  usageRecords       UsageRecord[]
  phoneNumbers       PhoneNumber[]
  webhookEndpoints   WebhookEndpoint[]
  webhookDeliveries  WebhookDelivery[]
  werMeasurements    WerMeasurement[]
  subscription       Subscription?
  integrations       Integration[]
  notifications      Notification[]
  usageRollups       UsageRollup[]

  @@map("organizations")
}

/// A human identity. A user may belong to several organizations via Membership.
model User {
  id             String     @id @default(uuid())
  email          String     @unique
  hashedPassword String?    @map("hashed_password")
  name           String?
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  memberships         Membership[]
  sessions            Session[]
  sentInvitations     Invitation[] @relation("InvitationInvitedBy")
  acceptedInvitations Invitation[] @relation("InvitationAcceptedBy")
  createdApiKeys      ApiKey[]     @relation("ApiKeyCreatedBy")

  @@map("users")
}

/// Join between User and Organization, carrying the user's role in that org.
model Membership {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  userId         String         @map("user_id")
  role           MembershipRole @default(MEMBER)
  invitedAt      DateTime?      @map("invited_at")
  acceptedAt     DateTime?      @map("accepted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Authentication & multi-tenant core (Phase 2)
// ---------------------------------------------------------------------------

/// An authentication session: the server-side source of truth for a rotating
/// refresh-token chain. The raw refresh token has the shape `<sessionId>.<secret>`;
/// only a hash of `<secret>` is stored (`tokenHash`). On refresh the token is
/// rotated (a new secret replaces `tokenHash`); presenting an already-rotated
/// token for an ACTIVE session is treated as reuse/theft and revokes the session.
/// Not tenant-scoped by the Prisma extension — it is keyed by user and used
/// during authentication, before a tenant context exists. `organizationId` is the
/// session's currently-active organization (updated by switch-org).
model Session {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  /// The session's currently-active organization (updated by switch-org). Null
  /// for an orgless user who has registered but not yet created or joined an org.
  organizationId String?       @map("organization_id")
  tokenHash      String        @unique @map("token_hash")
  status         SessionStatus @default(ACTIVE)
  userAgent      String?       @map("user_agent")
  ip             String?
  expiresAt      DateTime      @map("expires_at")
  lastUsedAt     DateTime      @default(now()) @map("last_used_at")
  revokedAt      DateTime?     @map("revoked_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("sessions")
}

/// An invitation for a (possibly not-yet-registered) user to join an organization
/// with a given role. The raw invite token is delivered out of band; only its hash
/// is stored. A membership is created when the invite is accepted.
model Invitation {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  email          String
  role           MembershipRole   @default(MEMBER)
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(PENDING)
  invitedById    String?          @map("invited_by_id")
  acceptedById   String?          @map("accepted_by_id")
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  revokedAt      DateTime?        @map("revoked_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, email])
  @@map("invitations")
}

/// An organization-scoped, server-to-server credential. The raw key
/// (`ovz_live_<prefix>.<secret>`) is shown exactly once at creation; only the
/// `prefix` (for lookup/identification) and a hash of the secret (`hashedKey`)
/// are stored. Tenant-scoped (enforced by the Prisma extension).
model ApiKey {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  prefix         String       @unique
  hashedKey      String       @map("hashed_key")
  scopes         String[]     @default([])
  status         ApiKeyStatus @default(ACTIVE)
  lastUsedAt     DateTime?    @map("last_used_at")
  expiresAt      DateTime?    @map("expires_at")
  revokedAt      DateTime?    @map("revoked_at")
  createdById    String?      @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("api_keys")
}

/// Append-only security/compliance audit trail. `organizationId` is nullable for
/// platform-level actions (e.g. a login before an org is resolved). Written by a
/// system-level writer with an explicit org, so it is intentionally NOT in the
/// Prisma extension's tenant-scoped set (which requires a non-null org context).
model AuditLog {
  id             String         @id @default(uuid())
  organizationId String?        @map("organization_id")
  actorType      AuditActorType @default(USER) @map("actor_type")
  actorId        String?        @map("actor_id")
  action         String
  targetType     String?        @map("target_type")
  targetId       String?        @map("target_id")
  metadata       Json?
  ip             String?
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, action])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// AI agents & knowledge base (Phase 3)
// ---------------------------------------------------------------------------

/// A configured AI voice receptionist. `config` holds model params, tool
/// toggles, business hours, etc. Published snapshots live in AgentVersion.
model Agent {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  name           String
  status         AgentStatus @default(DRAFT)
  defaultLanguage Language   @default(UZ) @map("default_language")
  systemPrompt   String?     @map("system_prompt")
  voiceId        String?     @map("voice_id")
  greeting       String?
  transferNumber String?     @map("transfer_number")
  config         Json?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       AgentVersion[]
  knowledgeBases KnowledgeBase[]
  appointments   Appointment[]
  calls          Call[]
  phoneNumbers   PhoneNumber[]

  @@index([organizationId])
  @@map("agents")
}

/// An immutable, published snapshot of an agent's configuration. Append-only.
model AgentVersion {
  id             String   @id @default(uuid())
  agentId        String   @map("agent_id")
  organizationId String   @map("organization_id")
  version        Int
  config         Json
  publishedAt    DateTime @default(now()) @map("published_at")
  createdAt      DateTime @default(now()) @map("created_at")

  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@index([organizationId])
  @@map("agent_versions")
}

/// A collection of documents an agent answers from.
model KnowledgeBase {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  agentId        String?             @map("agent_id")
  name           String
  status         KnowledgeBaseStatus @default(ACTIVE)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  documents    KnowledgeDocument[]

  @@index([organizationId])
  @@map("knowledge_bases")
}

/// A source document ingested into a knowledge base. For TEXT/FAQ sources the
/// raw text is stored inline in `content` (Phase 3); UPLOAD/URL use object
/// storage in a later phase. `organizationId` is denormalized for tenant scoping.
model KnowledgeDocument {
  id              String                  @id @default(uuid())
  knowledgeBaseId String                  @map("knowledge_base_id")
  organizationId  String                  @map("organization_id")
  title           String
  sourceType      KnowledgeSourceType     @map("source_type")
  sourceUri       String?                 @map("source_uri")
  content         String?
  status          KnowledgeDocumentStatus @default(PENDING)
  bytes           Int?
  checksum        String?
  error           String?
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  deletedAt       DateTime?               @map("deleted_at")

  knowledgeBase KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks        KnowledgeChunk[]

  @@index([organizationId])
  @@index([knowledgeBaseId])
  @@map("knowledge_documents")
}

/// A retrievable fragment of a document. `embedding` is the dense vector (stored
/// as a float array; app-side cosine retrieval — see CLAUDE.md). Append-only.
model KnowledgeChunk {
  id              String   @id @default(uuid())
  documentId      String   @map("document_id")
  knowledgeBaseId String   @map("knowledge_base_id")
  organizationId  String   @map("organization_id")
  ordinal         Int
  content         String
  tokenCount      Int      @map("token_count")
  embedding       Float[]
  embeddingModel  String   @map("embedding_model")
  createdAt       DateTime @default(now()) @map("created_at")

  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([knowledgeBaseId])
  @@index([documentId])
  @@map("knowledge_chunks")
}

/// A caller/contact known to an organization. PII.
model Customer {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  phoneE164       String    @map("phone_e164")
  name            String?
  email           String?
  locale          String    @default("uz")
  notes           String?
  tags            String[]  @default([])
  lastContactedAt DateTime? @map("last_contacted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  calls        Call[]

  @@index([organizationId])
  @@index([organizationId, phoneE164])
  @@map("customers")
}

/// A booking created by an agent or by staff.
model Appointment {
  id                 String            @id @default(uuid())
  organizationId     String            @map("organization_id")
  customerId         String            @map("customer_id")
  agentId            String?           @map("agent_id")
  /// The call during which the AI booked this appointment, if any (audit trail).
  callId             String?           @map("call_id")
  title              String
  notes              String?
  startsAt           DateTime          @map("starts_at")
  endsAt             DateTime?         @map("ends_at")
  status             AppointmentStatus @default(PENDING)
  externalCalendarId String?           @map("external_calendar_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  call         Call?        @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, startsAt])
  @@index([customerId])
  @@index([callId])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// Voice / calls (Phase 4)
// ---------------------------------------------------------------------------

/// The central record of a phone interaction. PII. Mutated during the call,
/// append-only (ledger) thereafter. `recordingObjectKey` is an S3 key, not audio.
/// (PhoneNumber linkage arrives in Phase 5.)
model Call {
  id                 String        @id @default(uuid())
  organizationId     String        @map("organization_id")
  agentId            String?       @map("agent_id")
  customerId         String?       @map("customer_id")
  direction          CallDirection @default(INBOUND)
  status             CallStatus    @default(QUEUED)
  fromE164           String?       @map("from_e164")
  toE164             String?       @map("to_e164")
  language           Language      @default(UZ)
  startedAt          DateTime      @default(now()) @map("started_at")
  answeredAt         DateTime?     @map("answered_at")
  endedAt            DateTime?     @map("ended_at")
  durationSec        Int?          @map("duration_sec")
  endedReason        String?       @map("ended_reason")
  recordingObjectKey String?       @map("recording_object_key")
  recordingConsent   Boolean       @default(false) @map("recording_consent")
  costCents          Int?          @map("cost_cents")
  phoneNumberId      String?       @map("phone_number_id")
  /// E.164 target a transfer was handed off to (Phase 5).
  transferredTo      String?       @map("transferred_to")
  /// External room/session reference (e.g. LiveKit room name).
  externalRef        String?       @map("external_ref")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  phoneNumber  PhoneNumber?  @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  events       CallEvent[]
  transcript   Transcript?
  usageRecords UsageRecord[]
  appointments Appointment[]

  @@index([organizationId])
  @@index([organizationId, status, startedAt])
  @@map("calls")
}

/// Append-only lifecycle event for a call (ringing, answered, tool, hangup, …).
model CallEvent {
  id             String   @id @default(uuid())
  callId         String   @map("call_id")
  organizationId String   @map("organization_id")
  type           String
  payload        Json?
  occurredAt     DateTime @default(now()) @map("occurred_at")
  createdAt      DateTime @default(now()) @map("created_at")

  call         Call         @relation(fields: [callId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([callId, occurredAt])
  @@index([organizationId])
  @@map("call_events")
}

/// One transcript per call; authoritative content is the ordered TranscriptTurns.
model Transcript {
  id             String           @id @default(uuid())
  callId         String           @unique @map("call_id")
  organizationId String           @map("organization_id")
  language       Language         @default(UZ)
  fullText       String?          @map("full_text")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  call         Call             @relation(fields: [callId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  turns        TranscriptTurn[]

  @@index([organizationId])
  @@map("transcripts")
}

/// The primary representation of transcript content — one row per utterance.
/// Append-only. Sensitive PII.
model TranscriptTurn {
  id             String         @id @default(uuid())
  transcriptId   String         @map("transcript_id")
  organizationId String         @map("organization_id")
  role           TranscriptRole
  text           String
  startMs        Int            @map("start_ms")
  endMs          Int?           @map("end_ms")
  confidence     Float?
  language       Language?
  createdAt      DateTime       @default(now()) @map("created_at")

  transcript   Transcript   @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([transcriptId])
  @@index([organizationId])
  @@map("transcript_turns")
}

/// Metered usage ledger for billing/quota. Append-only.
model UsageRecord {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  metric         UsageMetric
  quantity       Decimal
  callId         String?     @map("call_id")
  occurredAt     DateTime    @default(now()) @map("occurred_at")
  periodKey      String      @map("period_key")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  call         Call?        @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, metric, periodKey])
  @@map("usage_records")
}

// ---------------------------------------------------------------------------
// Telephony productionization (Phase 5)
// ---------------------------------------------------------------------------

/// A provisioned telephony number routed to an agent. `provider`/`providerNumberId`
/// reference the external telephony/SIP provider (real provisioning is deployment
/// config; dev uses a mock provider).
model PhoneNumber {
  id               String            @id @default(uuid())
  organizationId   String            @map("organization_id")
  e164             String            @unique
  provider         String
  providerNumberId String?           @map("provider_number_id")
  agentId          String?           @map("agent_id")
  status           PhoneNumberStatus @default(ACTIVE)
  capabilities     String[]          @default([])
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  calls        Call[]

  @@index([organizationId])
  @@map("phone_numbers")
}

/// A tenant-registered destination for outbound event notifications. `secret` is
/// stored hashed; deliveries are signed HMAC-SHA256 (docs/API.md §13).
model WebhookEndpoint {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  url            String
  events         String[]          @default([])
  /// HMAC signing secret for outbound deliveries. Must be recoverable to sign,
  /// so it is NOT a one-way hash: store encrypted at rest in production (KMS /
  /// secretRef, see docs/SECURITY.md §5); plaintext is used only in dev.
  secret         String            @map("hashed_secret")
  status         WebhookStatus     @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_endpoints")
}

/// A single webhook delivery attempt record. Append-only.
model WebhookDelivery {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  endpointId     String                @map("endpoint_id")
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?                  @map("response_status")
  lastAttemptAt  DateTime?             @map("last_attempt_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

/// A Word Error Rate measurement for a provider/language (docs/VOICE_PIPELINE.md
/// §9), the KPI that decides Uzbek STT routing. Append-only. Phase-5 addition.
model WerMeasurement {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  provider       String
  language       Language
  wer            Float
  substitutions  Int      @default(0)
  deletions      Int      @default(0)
  insertions     Int      @default(0)
  referenceWords Int      @map("reference_words")
  callId         String?  @map("call_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([provider, language])
  @@map("wer_measurements")
}

// ---------------------------------------------------------------------------
// Billing & integrations (Phase 6)
// ---------------------------------------------------------------------------

/// Platform-wide billing plan catalog. Global (not tenant-scoped). `limits` holds
/// per-plan caps (e.g. maxAgents, includedMinutes) as JSON.
model Plan {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  priceCents Int      @map("price_cents")
  currency   String   @default("UZS")
  limits     Json?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

/// An organization's active plan subscription (one per org). `external*` reference
/// the payment provider; a mock provider is used in dev.
model Subscription {
  id                     String             @id @default(uuid())
  organizationId         String             @unique @map("organization_id")
  planId                 String             @map("plan_id")
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  externalCustomerId     String?            @map("external_customer_id")
  externalSubscriptionId String?            @map("external_subscription_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("subscriptions")
}

/// A third-party connection configured by a tenant (calendar / CRM / payments).
/// `config` holds non-secret settings; `secretRef` points at the secret store.
model Integration {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  type           IntegrationType
  provider       String
  status         IntegrationStatus @default(CONNECTED)
  config         Json?
  secretRef      String?           @map("secret_ref")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, type])
  @@map("integrations")
}

/// A notification dispatched for a key event (booking confirmation, missed call,
/// transfer). Append-only log; delivery is via a NotificationProvider.
model Notification {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  event          String
  recipient      String?
  subject        String?
  body           String
  metadata       Json?
  sentAt         DateTime?           @map("sent_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, event])
  @@map("notifications")
}

/// A metered-usage rollup for a billing period (aggregated from UsageRecord by the
/// jobs-worker). `rawCount` is the number of source records (for reconciliation).
model UsageRollup {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  metric         UsageMetric
  periodKey      String      @map("period_key")
  quantity       Decimal
  rawCount       Int         @map("raw_count")
  computedAt     DateTime    @default(now()) @map("computed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, periodKey])
  @@index([organizationId])
  @@map("usage_rollups")
}
