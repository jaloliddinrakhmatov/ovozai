{
  "name": "@ovozai/database",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./src/generated/client/index.js",
  "types": "./src/generated/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/generated/client/index.d.ts",
      "default": "./src/generated/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "migrate:init-offline": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "studio": "prisma studio",
    "seed": "tsx src/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf src/generated .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@prisma/client": "catalog:",
    "@prisma/client-runtime-utils": "catalog:"
  },
  "devDependencies": {
    "@ovozai/config": "workspace:*",
    "@ovozai/integrations": "workspace:*",
    "@prisma/adapter-pg": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
